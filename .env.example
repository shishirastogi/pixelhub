# Copy to .env and fill in. See docs/01-architecture.md §5.

# --- Database ---
DATABASE_URL="postgresql://pixelhub:pixelhub@localhost:5432/pixelhub?schema=public"

# --- Redis (BullMQ queues, cache, sessions) ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (MinIO locally, AWS S3 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="pixelhub"
S3_SECRET_ACCESS_KEY="pixelhub-secret"
S3_BUCKET="pixelhub"

# --- Auth ---
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- Watcher (per-project pairing token signing) ---
WATCHER_TOKEN_SECRET="replace-me-with-a-long-random-string"

# --- AI (Groq or OpenAI) ---
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL_DEFAULT="qwen/qwen3.8-27b"
GROQ_MODEL_VISION="qwen/qwen3.8-27b"
OPENAI_API_KEY=""
OPENAI_MODEL_DEFAULT="gpt-4o-mini"
OPENAI_MODEL_VISION="gpt-4o"

# --- Email OTP (Nodemailer SMTP or Resend API) ---
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PixelHub <no-reply@pixelhub.dev>"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
